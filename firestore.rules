rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/merchants/{merchantId} {
   function owner() { return request.auth != null && request.auth.uid == uid; }
   function valid() {
    let d = request.resource.data;
    return d.keys().hasOnly(['id','name','gstin','loginId','email','phone','category','notes','updatedAt','credential'])
      && d.keys().hasAll(['id','name','gstin','loginId','email','phone','category','notes','updatedAt'])
      && d.id == merchantId && d.name is string && d.name.size() > 0 && d.name.size() <= 200
      && d.loginId is string && d.loginId.size() > 0 && d.loginId.size() <= 200
      && d.gstin is string && d.gstin.size() <= 15
      && d.email is string && d.email.size() <= 200
      && d.phone is string && d.phone.size() <= 200
      && d.category is string && d.category.size() <= 100
      && d.notes is string && d.notes.size() <= 3000
      && d.updatedAt is string && d.updatedAt.size() <= 40
      && (!('credential' in d) || (d.credential is map
       && d.credential.keys().hasOnly(['cipher','salt','iv','version'])
       && d.credential.keys().hasAll(['cipher','salt','iv','version'])
       && d.credential.version == 1
       && d.credential.cipher is string && d.credential.cipher.size() <= 6000
       && d.credential.salt is string && d.credential.salt.size() == 24
       && d.credential.iv is string && d.credential.iv.size() == 16));
   }
   allow read, delete: if owner();
   allow create, update: if owner() && valid();
  }
 }
}
